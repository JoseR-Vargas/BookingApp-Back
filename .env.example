# MongoDB connection string. Locally this can point to a local mongod
# instance; in Vercel it MUST point to a reachable database (e.g. MongoDB
# Atlas) since Vercel functions cannot reach `localhost`.
MONGO_URI=mongodb://localhost:27017/booking

# Port for local development only (ignored by Vercel).
PORT=3000

# NODE_ENV controls CORS origin restrictions in src/main.ts and
# src/bookings/bookings.gateway.ts. Vercel sets this to "production"
# automatically.
NODE_ENV=development

# --- WhatsApp bot (Meta Cloud API). Full guide: docs/whatsapp-setup.md ---
# Every WhatsApp variable is optional: with none set the app boots and
# WhatsApp features stay off. Never commit real values.

# Permanent System User token (whatsapp_business_messaging +
# whatsapp_business_management). The 24h test token is for quick tests only.
WHATSAPP_ACCESS_TOKEN=

# Phone number ID of the sender (a numeric id, NOT the phone number).
WHATSAPP_PHONE_NUMBER_ID=

# App Secret (App settings -> Basic). Signs webhook calls; without it every
# webhook POST is rejected with 401.
WHATSAPP_APP_SECRET=

# Random string you invent and also type in Meta's webhook form.
# Generate one with: openssl rand -hex 24
WHATSAPP_VERIFY_TOKEN=

# Graph API version (blank = v21.0).
WHATSAPP_API_VERSION=

# Admin that is notified of every new booking: digits with country code,
# no "+" (e.g. 5491155551234). Blank = no admin notification.
ADMIN_WHATSAPP_NUMBER=

# Approved utility template for the admin notification
# (blank = nueva_reserva / es). Body variables {{1}}..{{6}}: client, service,
# professional, date dd/mm/yyyy, time HH:MM, client phone.
WHATSAPP_ADMIN_TEMPLATE_NAME=
WHATSAPP_ADMIN_TEMPLATE_LANG=

# Approved utility template for the "booking cancelled" notice to the admin.
# Same six body variables as the new-booking template, same language
# (WHATSAPP_ADMIN_TEMPLATE_LANG). Blank = the admin is not told on WhatsApp.
WHATSAPP_ADMIN_CANCEL_TEMPLATE_NAME=

# IANA time zone of the business (e.g. America/Mexico_City). REQUIRED for the
# bot (without it the bot replies "try again later" and never books) and for
# cancelling a booking from its link (without it the cancel endpoints answer
# 503). See docs/booking-cancellation.md.
BUSINESS_TIMEZONE=

# --- Booking cancellation ---
# Public base URL of the frontend, e.g. https://your-domain.com (http or https).
# Used to build the cancel link in the confirmation email. Blank = the email is
# sent without the cancel link.
PUBLIC_APP_URL=

# --- Admin panel ---
# Shared secret that protects every /api/admin/* route (sent by the admin UI as
# "Authorization: Bearer <key>"). If it is blank or unset, ALL admin routes
# answer 401. Generate one with: openssl rand -hex 32
ADMIN_API_KEY=

# --- Owner panel (spec 25) ---
# Key of the owner of the system: it opens /api/platform/* (the list of the
# businesses, their signals, the metrics and the manual actions). It is NOT the
# admin key of a business: the two never open each other's routes. If it is
# blank or unset, EVERY platform route answers 401 (it fails closed).
# Generate one with: openssl rand -hex 32
PLATFORM_API_KEY=

# How long the metrics of the installation are cached in memory, in seconds
# (default 60). `0` turns the cache off. It protects the limit of 100
# operations per second of the free tier of Atlas.
PLATFORM_METRICS_CACHE_TTL_SECONDS=60

# --- Plans and billing (spec 23) ---
# Which payment gateway is used. Only "fake" is bundled (a simulator for
# development and the e2e); a real provider adds its adapter and its name here.
# An unknown value stops the app at startup.
PAYMENT_GATEWAY=fake

# Secret used to sign and verify the payment webhooks (HMAC-SHA256 of the raw
# body). REQUIRED in production: the app refuses to start without it.
PAYMENT_WEBHOOK_SECRET=

# Where the fake gateway sends the customer to "pay" (development only).
PAYMENT_FAKE_CHECKOUT_URL=http://localhost:5173/plan/fake-checkout
